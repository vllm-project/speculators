{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrReview",
  "description": "One drafted pull-request review; see output.md.",
  "type": "object",
  "required": ["version", "pr", "summary", "findings"],
  "properties": {
    "version": {"const": 1},
    "pr": {"type": ["integer", "string"]},
    "summary": {"type": "string", "description": "Overall assessment; posted only alongside a surviving finding."},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["confidence", "body"],
        "properties": {
          "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
          "body": {"type": "string", "minLength": 1},
          "file": {"type": "string", "description": "Omit, with line, for a finding about the PR as a whole."},
          "line": {"type": "integer", "minimum": 1},
          "start_line": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
